{
  "name": "pronavigator",
  "version": "1.0.0",
  "description": "公司内部导航站，支持管理员维护分类与网站，访客公开访问",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "tailwind:build": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "navigation",
    "internal-tools",
    "nodejs",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.1.0",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.19.0",
    "express-validator": "^7.1.0",
    "jsdom": "^24.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^13.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.0"
  }
}
