<% layout('admin/layout') -%>

<div class="bg-white shadow rounded-lg p-6">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-900">网站管理</h2>
    <button id="addWebsiteBtn" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm hover:bg-blue-700">新增网站</button>
  </div>

  <div class="mb-4">
    <label class="text-sm text-gray-700">按分类筛选：</label>
    <select id="categoryFilter" class="mt-1 border border-gray-300 rounded-md px-3 py-2 text-sm">
      <option value="">全部</option>
      <% categories.forEach(function(category) { %>
        <option value="<%= category.id %>"><%= category.categoryName %></option>
      <% }) %>
    </select>
  </div>

  <div id="websiteList" class="space-y-2">
    <% categories.forEach(function(category) { %>
      <div class="mb-6">
        <h3 class="text-lg font-medium text-gray-900 mb-2"><%= category.categoryName %></h3>
        <div class="space-y-2 website-group" data-category-id="<%= category.id %>">
          <% websites.filter(w => w.categoryId === category.id).forEach(function(website) { %>
            <div class="website-item flex items-center justify-between p-3 bg-gray-50 rounded-md cursor-move" data-id="<%= website.id %>">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-gray-400 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <% if (website.logo) { %>
                  <img src="<%= website.logo %>" class="w-8 h-8 rounded object-cover mr-3">
                <% } else { %>
                  <div class="w-8 h-8 rounded bg-blue-100 flex items-center justify-center text-blue-600 text-xs font-bold mr-3"><%= website.websiteName.charAt(0).toUpperCase() %></div>
                <% } %>
                <div>
                  <div class="font-medium text-gray-900"><%= website.websiteName %></div>
                  <div class="text-xs text-gray-500 truncate max-w-xs"><%= website.url %></div>
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <button class="edit-btn text-blue-600 hover:text-blue-800 text-sm" data-website='<%= JSON.stringify(website) %>'>编辑</button>
                <button class="delete-btn text-red-600 hover:text-red-800 text-sm" data-id="<%= website.id %>">删除</button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<div id="websiteModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center overflow-y-auto">
  <div class="bg-white rounded-lg p-6 w-full max-w-2xl my-8">
    <h3 id="websiteModalTitle" class="text-lg font-medium text-gray-900 mb-4">新增网站</h3>
    <form id="websiteForm" class="space-y-4">
      <input type="hidden" id="websiteId">
      <div>
        <label class="block text-sm font-medium text-gray-700">网站名称</label>
        <input type="text" id="websiteName" name="websiteName" required maxlength="100" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">URL</label>
        <input type="url" id="url" name="url" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">所属分类</label>
        <select id="categoryId" name="categoryId" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
          <% categories.forEach(function(category) { %>
            <option value="<%= category.id %>"><%= category.categoryName %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Logo</label>
        <input type="file" id="logo" name="logo" accept="image/*" class="mt-1 block w-full text-sm text-gray-500">
        <div id="currentLogo" class="mt-2 hidden"></div>
        <label class="inline-flex items-center mt-2 hidden" id="removeLogoWrapper">
          <input type="checkbox" id="removeLogo" name="removeLogo" class="rounded border-gray-300 text-blue-600 shadow-sm">
          <span class="ml-2 text-sm text-gray-700">删除当前 Logo</span>
        </label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">说明（Markdown）</label>
        <div id="editor"></div>
        <textarea id="description" name="description" class="hidden"></textarea>
      </div>
    </form>
    <div id="websiteModalError" class="text-sm text-red-600 hidden mt-4"></div>
    <div class="flex justify-end space-x-3 mt-6">
      <button id="websiteCancelBtn" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900">取消</button>
      <button id="websiteSaveBtn" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700">保存</button>
    </div>
  </div>
</div>

<script>
  let editor = null;
  let editingWebsiteId = null;

  const websiteModal = document.getElementById('websiteModal');
  const websiteModalTitle = document.getElementById('websiteModalTitle');
  const websiteModalError = document.getElementById('websiteModalError');
  const websiteForm = document.getElementById('websiteForm');

  function openWebsiteModal(website = null) {
    editingWebsiteId = website ? website.id : null;
    websiteModalTitle.textContent = website ? '编辑网站' : '新增网站';
    document.getElementById('websiteName').value = website ? website.websiteName : '';
    document.getElementById('url').value = website ? website.url : '';
    document.getElementById('categoryId').value = website ? website.categoryId : '';
    document.getElementById('description').value = website ? (website.description || '') : '';

    const currentLogo = document.getElementById('currentLogo');
    const removeLogoWrapper = document.getElementById('removeLogoWrapper');
    document.getElementById('removeLogo').checked = false;

    if (website && website.logo) {
      currentLogo.innerHTML = `<img src="${website.logo}" class="h-16 rounded">`;
      currentLogo.classList.remove('hidden');
      removeLogoWrapper.classList.remove('hidden');
    } else {
      currentLogo.innerHTML = '';
      currentLogo.classList.add('hidden');
      removeLogoWrapper.classList.add('hidden');
    }

    websiteModalError.classList.add('hidden');
    websiteModal.classList.remove('hidden');

    if (!editor) {
      editor = new toastui.Editor({
        el: document.getElementById('editor'),
        initialEditType: 'markdown',
        previewStyle: 'vertical',
        height: '300px',
        initialValue: website ? (website.description || '') : '',
        events: {
          change: () => {
            document.getElementById('description').value = editor.getMarkdown();
          }
        }
      });
    } else {
      editor.setMarkdown(website ? (website.description || '') : '');
    }
  }

  function closeWebsiteModal() {
    websiteModal.classList.add('hidden');
    editingWebsiteId = null;
    websiteForm.reset();
    if (editor) {
      editor.setMarkdown('');
    }
  }

  document.getElementById('addWebsiteBtn').addEventListener('click', () => openWebsiteModal());
  document.getElementById('websiteCancelBtn').addEventListener('click', closeWebsiteModal);

  document.getElementById('websiteSaveBtn').addEventListener('click', async () => {
    const formData = new FormData(websiteForm);
    formData.set('description', editor ? editor.getMarkdown() : '');

    const url = editingWebsiteId ? `/api/admin/websites/${editingWebsiteId}` : '/api/admin/websites';
    const token = localStorage.getItem('nav_token');

    try {
      const response = await fetch(url, {
        method: editingWebsiteId ? 'PUT' : 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formData,
      });
      const data = await response.json();

      if (data.code === 0) {
        closeWebsiteModal();
        window.location.reload();
      } else {
        websiteModalError.textContent = data.message;
        websiteModalError.classList.remove('hidden');
      }
    } catch (err) {
      websiteModalError.textContent = '网络错误，请重试';
      websiteModalError.classList.remove('hidden');
    }
  });

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const website = JSON.parse(btn.dataset.website);
      openWebsiteModal(website);
    });
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('确定删除该网站吗？')) return;
      const data = await apiFetch(`/api/admin/websites/${btn.dataset.id}`, { method: 'DELETE' });
      if (data.code === 0) {
        window.location.reload();
      } else {
        alert(data.message);
      }
    });
  });

  document.getElementById('categoryFilter').addEventListener('change', (e) => {
    const categoryId = e.target.value;
    document.querySelectorAll('.website-group').forEach(group => {
      const id = group.dataset.categoryId;
      group.parentElement.style.display = categoryId && id !== categoryId ? 'none' : '';
    });
  });

  document.querySelectorAll('.website-group').forEach(group => {
    Sortable.create(group, {
      animation: 150,
      handle: '.website-item',
      ghostClass: 'sortable-ghost',
      group: {
        name: 'websites',
        pull: false,
        put: false,
      },
      onEnd: async () => {
        const categoryId = group.dataset.categoryId;
        const ids = Array.from(group.querySelectorAll('.website-item')).map(el => parseInt(el.dataset.id, 10));
        const data = await apiFetch(`/api/admin/categories/${categoryId}/websites/order`, {
          method: 'PUT',
          body: JSON.stringify({ ids }),
        });
        if (data.code !== 0) {
          alert(data.message || '排序保存失败');
          window.location.reload();
        }
      },
    });
  });
</script>