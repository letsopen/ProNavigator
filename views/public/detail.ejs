<%- include('../partials/header') %>

<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-6">
    <a href="/" class="text-sm text-blue-600 hover:text-blue-800">&larr; 返回首页</a>
  </div>

  <div class="bg-white rounded-lg shadow p-8">
    <div class="flex items-start mb-6">
      <% if (website.logo) { %>
        <img src="<%= website.logo %>" alt="<%= website.websiteName %>" class="w-16 h-16 rounded-lg object-cover mr-5">
      <% } else { %>
        <div class="w-16 h-16 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold mr-5">
          <%= website.websiteName.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= website.websiteName %></h1>
        <a href="<%= website.url %>" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline break-all"><%= website.url %></a>
      </div>
    </div>

    <div class="prose prose-blue max-w-none border-t border-gray-100 pt-6 markdown-body">
      <%- website.descriptionHtml %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>